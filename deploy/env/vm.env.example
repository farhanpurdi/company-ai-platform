# Profil VM. Salin ke deploy/env/vm.env, isi dari secret manager, lalu
# `chmod 600 deploy/env/vm.env`. File vm.env tidak pernah di-commit.
# LITELLM_SALT_KEY tidak boleh diganti setelah ada data di Postgres.
LITELLM_MASTER_KEY=sk-ganti-dari-secret-manager
LITELLM_SALT_KEY=sk-ganti-dari-secret-manager
POSTGRES_PASSWORD=ganti-dari-secret-manager
REDIS_PASSWORD=ganti-dari-secret-manager
DATABASE_URL=postgresql://litellm:ganti-dari-secret-manager@postgres:5432/litellm
OPENAI_API_KEY=sk-ganti-dengan-key-openai-project-gateway
OPENAI_API_BASE=https://api.openai.com/v1
# Sertifikat TLS: company (sertifikat perusahaan di TLS_CERT_DIR), internal
# (CA buatan Caddy, untuk akses lewat IP selama belum ada domain), atau off
# (HTTP polos tanpa sertifikat; key lewat jaringan tanpa enkripsi).
VM_TLS=company
LLM_HOST=llm.perusahaan.internal
LLM_ADMIN_HOST=llm-admin.perusahaan.internal
# Akses lewat IP (tanpa domain): VM_TLS=internal, lalu
#   LLM_HOST=10.0.0.5
#   LLM_ADMIN_HOST=10.0.0.5:8443
#   GATEWAY_CA_BUNDLE=/repo/var/caddy-vm-root.crt   (dibuat oleh `make vm-ca ENV=vm`)
# HTTP polos: VM_TLS=off, lalu isi GATEWAY_URL dengan alamat inference lengkap
# (skema http, host, dan LLM_HTTP_PORT bila bukan 80), misalnya
#   GATEWAY_URL=http://10.0.0.5:8080
# Port HTTP di host. Dengan VM_TLS=off ini port gateway; selain itu hanya untuk
# redirect ke HTTPS. Ganti dengan port kosong lain (misalnya 8080) bila port 80
# sudah dipakai aplikasi lain di VM.
LLM_HTTP_PORT=80
# Port HTTPS di host. Dengan VM_TLS=off tidak dipakai, tetapi tetap dipesan
# Docker. Ganti dengan port kosong lain (misalnya 9443) bila port 443 sudah
# dipakai aplikasi lain di VM; jangan 8443 (dipakai host admin lewat IP).
LLM_HTTPS_PORT=443
# Satu atau beberapa CIDR VPN dipisah spasi; hanya sumber ini yang boleh ke host admin.
VPN_CIDR=10.0.0.0/8
# Direktori di host berisi fullchain.pem dan privkey.pem (path absolut). Dengan
# VM_TLS=internal tetap wajib diisi, boleh berupa folder kosong.
TLS_CERT_DIR=/etc/llm-gateway/certs
