# Profil VM. Salin ke deploy/env/vm.env, isi dari secret manager, lalu
# `chmod 600 deploy/env/vm.env`. File vm.env tidak pernah di-commit.
# LITELLM_SALT_KEY tidak boleh diganti setelah ada data di Postgres.
LITELLM_MASTER_KEY=sk-ganti-dari-secret-manager
LITELLM_SALT_KEY=sk-ganti-dari-secret-manager
POSTGRES_PASSWORD=ganti-dari-secret-manager
REDIS_PASSWORD=ganti-dari-secret-manager
DATABASE_URL=postgresql://litellm:ganti-dari-secret-manager@postgres:5432/litellm
OPENAI_API_KEY=sk-ganti-dengan-key-openai-project-gateway
OPENAI_API_BASE=https://api.openai.com/v1
# Port litellm-a di host; pengguna memakai http://<ip-vm>:<port>/v1. Tanpa TLS:
# virtual key dan master key lewat jaringan kantor tanpa enkripsi sampai proxy
# DevOps dipasang (spec bagian 10). Ganti bila port 4000 sudah dipakai.
LITELLM_PORT=4000
