# Profil lokal. Jangan isi file ini dengan tangan: jalankan `make init-local`,
# yang membuat deploy/env/local.env berisi secret acak (izin 600).
# LITELLM_SALT_KEY tidak boleh diganti setelah ada data di Postgres.
LITELLM_MASTER_KEY=sk-<hex32>
LITELLM_SALT_KEY=sk-<hex32>
POSTGRES_PASSWORD=<hex32>
REDIS_PASSWORD=<hex32>
DATABASE_URL=postgresql://litellm:<POSTGRES_PASSWORD>@postgres:5432/litellm
OPENAI_API_KEY=sk-mock-<hex16>
OPENAI_API_BASE=http://mock-upstream:8080/v1
