# Local profile: internal CA, published on 127.0.0.1:8443 only.
# Shared upstream, access log and allowlist snippets live in common.caddy.
{
	skip_install_trust
}

import /etc/caddy/common.caddy

{$LLM_HOST} {
	tls internal
	import access_log
	import inference_allowlist
}

{$LLM_ADMIN_HOST} {
	tls internal
	import access_log
	import litellm_upstream
}
